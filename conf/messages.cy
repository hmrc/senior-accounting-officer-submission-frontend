certificateDeclarationSao.title = Declaration
certificateDeclarationSao.heading = Declaration
certificateDeclarationSao.label = I am the Senior Accounting Officer with the authority to submit this certificate:
certificateDeclarationSao.inputLabel = Nodwch eich enw llawn
certificateDeclarationSao.caption = Cyflwynwch dystysgrif
certificateDeclarationSao.paragraph1 = Fel yr SAO, eich cyfrifoldeb chi yw adolygu a chymeradwyo’r dystysgrif cyn i chi ei chyflwyno.
certificateDeclarationSao.paragraph2 = Drwy gyflwyno’r dystysgrif hon, rydych yn cadarnhau’r canlynol:
certificateDeclarationSao.paragraph3 = Os byddwch chi’n rhoi gwybodaeth anghywir neu anghyflawn yn fwriadol, neu’n methu â rhoi gwybod am newidiadau, gallech fod yn agored i gosb o £5,000.
certificateDeclarationSao.paragraph4 = Rwy’n cadarnhau mai fi yw’r Uwch-swyddog Cyfrifyddu sydd â’r awdurdod i gyflwyno’r dystysgrif hon:
certificateDeclarationSao.list1.item1 = mae’r wybodaeth yn gyflawn ac yn gywir
certificateDeclarationSao.list1.item2 = chi yw’r SAO sy’n cyflwyno’r dystysgrif hon
certificateDeclarationSao.inset.text = If you realise the information you submitted is incorrect, contact HMRC using your usual compliance contact or existing support channels.
certificateDeclarationSao.button = Confirm
certificateDeclarationSao.checkYourAnswersLabel = Enw’r SAO ar y datganiad
certificateDeclarationSao.error.required = Enter the name of the SAO authorised to submit the certificate
certificateDeclarationSao.error.length = Name of the SAO must be 105 characters or less
certificateDeclarationSao.error.invalidSymbols = Name of the SAO must not include <, > or "
certificateDeclarationSao.change.hidden = The name of the SAO on the declaration

