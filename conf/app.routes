# microservice specific routes

->          /submission/hmrc-frontend                                                            hmrcfrontend.Routes
GET         /submission/assets/*file                                                             controllers.Assets.versioned(path = "/public", file: Asset)

GET         /submission/refresh-session                                                          controllers.KeepAliveController.keepAlive()

GET         /submission/there-is-a-problem                                                      controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[uk.gov.hmrc.play.bootstrap.binders.RedirectUrl] ?= None, section: Option[models.JourneySection] ?= None)

GET         /submission/template/guidance/make-a-submission                                                       controllers.TemplateGuidanceController.onPageLoad()
GET         /submission/template-guidance                                               controllers.TemplateGuidanceController.onPageLoadNewTab()

GET         /submission/notification/template/download                                           controllers.DownloadTemplateController.downloadFile()

GET         /submission                                                          controllers.SubmissionTypeController.onPageLoad()
POST        /submission                                                          controllers.SubmissionTypeController.onSubmit()

##############################
# Notification only journey routes
##############################

GET         /submission/notification/task                                                       controllers.notification.NotificationTaskListController.onPageLoad()
GET         /submission/notification/task/complete                                                    controllers.notification.NotificationTaskListController.onComplete()
POST        /submission/notification/task/complete                                                    controllers.notification.NotificationTaskListController.onCompleteSubmit()

GET         /submission/notification/confirm-multiple-officers                                           controllers.notification.NotificationMoreThanOneSaoController.onPageLoad(mode: Mode)
POST        /submission/notification/confirm-multiple-officers                                           controllers.notification.NotificationMoreThanOneSaoController.onSubmit(mode: Mode)


GET         /submission/notification/last/officer-name                controllers.notification.NotificationMultiSaoLastOfficerNameController.onPageLoad(mode: Mode)
POST        /submission/notification/last/officer-name               controllers.notification.NotificationMultiSaoLastOfficerNameController.onSubmit(mode: Mode)

GET         /submission/notification/last/officer-start-date        controllers.notification.NotificationMultiSaoLastOfficerStartDateController.onPageLoad(mode: Mode)
POST        /submission/notification/last/officer-start-date        controllers.notification.NotificationMultiSaoLastOfficerStartDateController.onSubmit(mode: Mode)

GET         /submission/notification/previous/officer-name                               controllers.notification.NotificationMultiSaoPreviousOfficerNameController.onPageLoad(mode: Mode, sao: Int ?= 0)
POST        /submission/notification/previous/officer-name                               controllers.notification.NotificationMultiSaoPreviousOfficerNameController.onSubmit(mode: Mode, sao: Int ?= 0)

GET         /submission/notification/previous/officer-start-date                          controllers.notification.NotificationMultiSaoPreviousOfficerStartDateController.onPageLoad(mode: Mode, sao: Int ?= 0)
POST        /submission/notification/previous/officer-start-date                          controllers.notification.NotificationMultiSaoPreviousOfficerStartDateController.onSubmit(mode: Mode, sao: Int ?= 0)

GET         /submission/notification/previous/officer-end-date                                   controllers.notification.NotificationMultiSaoPreviousOfficerEndDateController.onPageLoad(mode: Mode, sao: Int ?= 0)
POST        /submission/notification/previous/officer-end-date                                   controllers.notification.NotificationMultiSaoPreviousOfficerEndDateController.onSubmit(mode: Mode, sao: Int ?= 0)

GET         /submission/notification/add-officer                               controllers.notification.NotificationMultiSaoAreAllAddedController.onPageLoad(mode: Mode, sao: Int ?= 0)
POST        /submission/notification/add-officer                               controllers.notification.NotificationMultiSaoAreAllAddedController.onSubmit(mode: Mode, sao: Int ?= 0)

GET         /submission/notification/officer-name                controllers.notification.NotificationSingleSaoOfficerNameController.onPageLoad(mode: Mode)
POST        /submission/notification/officer-name                controllers.notification.NotificationSingleSaoOfficerNameController.onSubmit(mode: Mode)


GET         /submission/notification/upload-template                                                      controllers.notification.NotificationUploadFormController.onPageLoad()
GET         /submission/notification/uploading                                              controllers.notification.NotificationUploadSuccessController.onPageLoad(key: Option[String])
GET         /submission/notification/review-companies                                                controllers.notification.UploadTemplateTableController.onPageLoad(page: Int)
POST        /submission/notification/review-companies                                                controllers.notification.UploadTemplateTableController.onSubmit()

GET         /submission/notification/additional-information                               controllers.notification.NotificationAdditionalInformationController.onPageLoad(mode: Mode)
POST        /submission/notification/additional-information                               controllers.notification.NotificationAdditionalInformationController.onSubmit(mode: Mode)

GET         /submission/notification/check-answers                                          controllers.notification.NotificationCheckYourAnswersController.onPageLoad()
POST        /submission/notification/check-answers                                          controllers.notification.NotificationCheckYourAnswersController.onSubmit()

GET         /submission/notification/submitting                                                  controllers.notification.NotificationSubmittingController.onPageLoad(idempotencyKey: String)

GET         /submission/notification/confirmation                                                controllers.notification.NotificationConfirmationController.onPageLoad(notificationIdReferenceNumber: String)
GET         /submission/notification/download                                                    controllers.DownloadPdfController.notification(notificationReference: String)

GET         /submission/notification/confirm-notification                                   controllers.notification.ConfirmYourNotificationController.onPageLoad()
POST        /submission/notification/confirm-notification                                   controllers.notification.ConfirmYourNotificationController.onSubmit()

##############################
# certificate only journey routes
##############################

GET         /submission/certificate/task                                                  controllers.certificate.CertificateTaskListController.onPageLoad
GET         /submission/certificate/task/complete                                           controllers.certificate.CertificateTaskListController.onPageLoadComplete(certificateReference: String)
POST        /submission/certificate/task                                                    controllers.certificate.CertificateTaskListController.onSubmit(certificateReference: String)

GET         /submission/certificate/officer-name                             controllers.certificate.CertificateSaoFullNameController.onPageLoad(mode: Mode)
POST        /submission/certificate/officer-name                             controllers.certificate.CertificateSaoFullNameController.onSubmit(mode: Mode)

GET         /submission/certificate/email-address                                               controllers.certificate.CertificateSaoEmailController.onPageLoad(mode: Mode)
POST        /submission/certificate/email-address                                               controllers.certificate.CertificateSaoEmailController.onSubmit(mode: Mode)

GET         /submission/certificate/upload-template                                                       controllers.certificate.CertificateUploadFormController.onPageLoad()
GET         /submission/certificate/upload/success                                               controllers.certificate.CertificateUploadSuccessController.onPageLoad(key: Option[String])

GET         /submission/certificate/review-qualified-certificate                                               controllers.certificate.CertificateReviewQualifiedController.onPageLoad(page: Int)
POST        /submission/certificate/review-qualified-certificate                                               controllers.certificate.CertificateReviewQualifiedController.onSubmit()

GET         /submission/certificate/review-unqualified-certificate                                             controllers.certificate.CertificateReviewUnqualifiedController.onPageLoad(page: Int)
POST        /submission/certificate/review-unqualified-certificate                                             controllers.certificate.CertificateReviewUnqualifiedController.onSubmit()

GET         /submission/certificate/additional-information                                         controllers.certificate.CertificateAdditionalInformationController.onPageLoad(mode: Mode)
POST        /submission/certificate/additional-information                                         controllers.certificate.CertificateAdditionalInformationController.onSubmit(mode: Mode)

GET         /submission/certificate/officer-submit-certificate                                            controllers.certificate.CertificateWhoIsSubmittingController.onPageLoad(mode: Mode)
POST        /submission/certificate/officer-submit-certificate                                            controllers.certificate.CertificateWhoIsSubmittingController.onSubmit(mode: Mode)

GET         /submission/certificate/declaration/confirm-certificate                               controllers.certificate.CertificateDeclarationSaoController.onPageLoad(mode: Mode)
POST        /submission/certificate/declaration/confirm-certificate                               controllers.certificate.CertificateDeclarationSaoController.onSubmit(mode: Mode)

GET         /submission/certificate/declaration/confirm-authorised-submission                                         controllers.certificate.CertificateDeclarationStandInController.onPageLoad(mode: Mode)
POST        /submission/certificate/declaration/confirm-authorised-submission                                         controllers.certificate.CertificateDeclarationStandInController.onSubmit(mode: Mode)

GET         /submission/certificate/check-answers                                              controllers.certificate.CertificateCheckYourAnswersController.onPageLoad()
POST        /submission/certificate/check-answers                                              controllers.certificate.CertificateCheckYourAnswersController.onSubmit()

GET         /submission/certificate/submitting                                                   controllers.certificate.CertificateSubmittingController.onPageLoad(idempotencyKey: String)

GET         /submission/certificate/confirmation                                                 controllers.certificate.CertificateConfirmationController.onPageLoad(certificateIdReferenceNumber: String)

GET         /submission/certificate/download                                                     controllers.DownloadPdfController.certificate(certificateReference: String)

