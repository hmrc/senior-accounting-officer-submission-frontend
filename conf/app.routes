# microservice specific routes

->          /submission/hmrc-frontend                                                            hmrcfrontend.Routes
GET         /submission/assets/*file                                                             controllers.Assets.versioned(path = "/public", file: Asset)

GET         /submission/refresh-session                                                          controllers.KeepAliveController.keepAlive()

GET         /submission/there-is-a-problem                                                      controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[uk.gov.hmrc.play.bootstrap.binders.RedirectUrl] ?= None, section: Option[models.JourneySection] ?= None)

GET         /submission/template/guidance/make-a-submission                                                       controllers.TemplateGuidanceController.onPageLoad()
GET         /submission/template/guidance                                               controllers.TemplateGuidanceController.onPageLoadNewTab()

GET         /submission/notification/template/download                                           controllers.DownloadTemplateController.downloadFile()

GET         /submission                                                          controllers.SubmissionTypeController.onPageLoad()
POST        /submission                                                          controllers.SubmissionTypeController.onSubmit()

